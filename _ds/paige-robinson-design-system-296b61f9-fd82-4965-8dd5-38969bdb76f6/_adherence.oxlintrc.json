{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/chrome/**",
              "components/forms/**",
              "components/hero/**",
              "components/media/**",
              "components/navigation/**",
              "components/program/**",
              "components/type/**",
              "motion/**",
              "ui_kits/website/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Playfair|Hanken Grotesk))/i]",
        "message": "Font not provided by the design system. Available: Playfair, Hanken Grotesk."
      },
      {
        "selector": "JSXOpeningElement[name.name='AudioItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|detail|src|length|key|ref|className|style|children)$/]",
        "message": "<AudioItem> doesn't accept that prop. Declared props: title, detail, src, length."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|type|href|disabled|onClick|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, type, href, disabled, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:outline|text)$/]",
        "message": "<Button> variant must be one of 'outline' | 'text'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:button|submit|reset)$/]",
        "message": "<Button> type must be one of 'button' | 'submit' | 'reset'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CreditFilterOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<CreditFilterOption> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Credit'] > JSXAttribute > JSXIdentifier[name!=/^(?:role|production|company|kind|photo|key|ref|className|style|children)$/]",
        "message": "<Credit> doesn't accept that prop. Declared props: role, production, company, kind, photo."
      },
      {
        "selector": "JSXOpeningElement[name.name='Credit'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:opera|mt)$/]",
        "message": "<Credit> kind must be one of 'opera' | 'mt'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|wide|as|style|key|ref|className|style|children)$/]",
        "message": "<Eyebrow> doesn't accept that prop. Declared props: children, wide, as, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Eyebrow'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:p|span|div|h2|h3)$/]",
        "message": "<Eyebrow> as must be one of 'p' | 'span' | 'div' | 'h2' | 'h3'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GrandLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:href|children|eyebrow|size|below|key|ref|className|style|children)$/]",
        "message": "<GrandLink> doesn't accept that prop. Declared props: href, children, eyebrow, size, below."
      },
      {
        "selector": "JSXOpeningElement[name.name='GrandLink'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:email|display)$/]",
        "message": "<GrandLink> size must be one of 'email' | 'display'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Hairline'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|width|align|style|key|ref|className|style|children)$/]",
        "message": "<Hairline> doesn't accept that prop. Declared props: tone, width, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Hairline'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:candle|sand|moss)$/]",
        "message": "<Hairline> tone must be one of 'candle' | 'sand' | 'moss'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Hairline'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center|right)$/]",
        "message": "<Hairline> align must be one of 'left' | 'center' | 'right'."
      },
      {
        "selector": "JSXOpeningElement[name.name='HoverPhotoField'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|photos|className|key|ref|className|style|children)$/]",
        "message": "<HoverPhotoField> doesn't accept that prop. Declared props: children, photos, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='ImageSlot'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|focal|ratio|label|duotone|imgClassName|key|ref|className|style|children)$/]",
        "message": "<ImageSlot> doesn't accept that prop. Declared props: src, alt, focal, ratio, label, duotone, imgClassName."
      },
      {
        "selector": "JSXOpeningElement[name.name='LightboxItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|ratio|focal|production|year|label|key|ref|className|style|children)$/]",
        "message": "<LightboxItem> doesn't accept that prop. Declared props: src, alt, ratio, focal, production, year, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:numeral|title|href|key|ref|className|style|children)$/]",
        "message": "<NavItem> doesn't accept that prop. Declared props: numeral, title, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='Monogram'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|href|label|key|ref|className|style|children)$/]",
        "message": "<Monogram> doesn't accept that prop. Declared props: size, href, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='MotionSwitch'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|key|ref|className|style|children)$/]",
        "message": "<MotionSwitch> doesn't accept that prop. Declared props: value, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='MotionSwitch'] > JSXAttribute[name.name='value'] > Literal[value!=/^(?:full|subtle|off)$/]",
        "message": "<MotionSwitch> value must be one of 'full' | 'subtle' | 'off'."
      },
      {
        "selector": "JSXOpeningElement[name.name='OvertureHero'] > JSXAttribute > JSXIdentifier[name!=/^(?:first|last|eyebrow|src|alt|focal|duotone|enterHref|enterLabel|isStatic|key|ref|className|style|children)$/]",
        "message": "<OvertureHero> doesn't accept that prop. Declared props: first, last, eyebrow, src, alt, focal, duotone, enterHref, enterLabel, isStatic."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageTitle'] > JSXAttribute > JSXIdentifier[name!=/^(?:numeral|title|lede|align|as|key|ref|className|style|children)$/]",
        "message": "<PageTitle> doesn't accept that prop. Declared props: numeral, title, lede, align, as."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageTitle'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<PageTitle> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='PageTitle'] > JSXAttribute[name.name='as'] > Literal[value!=/^(?:h1|h2)$/]",
        "message": "<PageTitle> as must be one of 'h1' | 'h2'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Persona'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|note|key|ref|className|style|children)$/]",
        "message": "<Persona> doesn't accept that prop. Declared props: name, note."
      },
      {
        "selector": "JSXOpeningElement[name.name='PlainItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:text|detail|meta|key|ref|className|style|children)$/]",
        "message": "<PlainItem> doesn't accept that prop. Declared props: text, detail, meta."
      },
      {
        "selector": "JSXOpeningElement[name.name='NavItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:numeral|title|href|key|ref|className|style|children)$/]",
        "message": "<NavItem> doesn't accept that prop. Declared props: numeral, title, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='ReasonSelect'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|legend|options|value|defaultValue|onChange|key|ref|className|style|children)$/]",
        "message": "<ReasonSelect> doesn't accept that prop. Declared props: name, legend, options, value, defaultValue, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='RecentRole'] > JSXAttribute > JSXIdentifier[name!=/^(?:role|production|year|photo|key|ref|className|style|children)$/]",
        "message": "<RecentRole> doesn't accept that prop. Declared props: role, production, year, photo."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScreeningRoom'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|kind|title|caption|year|poster|key|ref|className|style|children)$/]",
        "message": "<ScreeningRoom> doesn't accept that prop. Declared props: src, kind, title, caption, year, poster."
      },
      {
        "selector": "JSXOpeningElement[name.name='ScreeningRoom'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:iframe|video)$/]",
        "message": "<ScreeningRoom> kind must be one of 'iframe' | 'video'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SocialLink'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|key|ref|className|style|children)$/]",
        "message": "<SocialLink> doesn't accept that prop. Declared props: label, href."
      },
      {
        "selector": "JSXOpeningElement[name.name='Still'] > JSXAttribute > JSXIdentifier[name!=/^(?:src|alt|ratio|focal|production|year|index|width|align|label|duotone|parallax|onOpen|key|ref|className|style|children)$/]",
        "message": "<Still> doesn't accept that prop. Declared props: src, alt, ratio, focal, production, year, index, width, align, label, duotone, parallax, onOpen."
      },
      {
        "selector": "JSXOpeningElement[name.name='Still'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|right|center)$/]",
        "message": "<Still> align must be one of 'left' | 'right' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='UnderlineField'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|name|type|multiline|rows|required|placeholder|value|defaultValue|onChange|autoComplete|hint|key|ref|className|style|children)$/]",
        "message": "<UnderlineField> doesn't accept that prop. Declared props: label, name, type, multiline, rows, required, placeholder, value, defaultValue, onChange, autoComplete, hint."
      },
      {
        "selector": "JSXOpeningElement[name.name='UnderlineField'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:text|email|tel)$/]",
        "message": "<UnderlineField> type must be one of 'text' | 'email' | 'tel'."
      }
    ]
  },
